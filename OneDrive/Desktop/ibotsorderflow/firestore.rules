rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow authenticated users to read employees and enquiries for testing.
    match /employees/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'admin';
    }

    match /enquiries/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        // admin can update all
        get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'admin'
        // or the assigned user can update
        || resource.data.assignedTo == request.auth.uid
      );
      match /audits/{auditId} {
        allow read, write: if request.auth != null;
      }
    }

    // fallback: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}